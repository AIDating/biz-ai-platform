# Local: SQLite file next to prisma/schema.prisma
DATABASE_URL="file:./dev.db"
# Vercel / production: use a Postgres URL instead, and set
# prisma/schema.prisma datasource provider to "postgresql".
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/redline?sslmode=require"

SESSION_SECRET="change-me-to-a-long-random-string"

# Leave empty to run with the labelled demo responder.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Optional. Cookies are Secure automatically on Vercel (HTTPS).
# COOKIE_SECURE=1
