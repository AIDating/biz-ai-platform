# Pooled Neon connection (has -pooler in the hostname) — used by the app.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Direct Neon connection (no -pooler) — used by Prisma CLI (db push / migrate).
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require"

SESSION_SECRET="change-me-to-a-long-random-string"

# Leave empty to run with the labelled demo responder.
OPENAI_API_KEY=""
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"

# Optional. Cookies are Secure automatically on Vercel (HTTPS).
# COOKIE_SECURE=1

# Optional. Comma-separated emails treated as platform admins even when role is "owner".
# Not required to build or run. Leave unset to rely only on User.role = "admin".
# PLATFORM_ADMIN_EMAILS=""
